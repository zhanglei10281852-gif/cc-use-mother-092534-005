{
  "project": "连接器最小权限会话代理",
  "entities": [
    "account_link",
    "capability",
    "task_demand",
    "consent_session",
    "connector_call",
    "external_receipt",
    "quota"
  ],
  "states": [
    "proposed",
    "consented",
    "active",
    "restricted",
    "isolated",
    "revoked",
    "reconciling",
    "closed"
  ],
  "event_types": [
    "demand.calculated",
    "consent.confirmed",
    "call.authorized",
    "call.completed",
    "scope.reduced",
    "capability.isolated",
    "receipt.received",
    "session.closed"
  ],
  "time_policy": "ISO 8601 with timezone",
  "identifier_policy": "同一租户和对象类型内业务标识唯一",
  "version_policy": "已发布规则与事实通过新版本追加，不覆盖历史",
  "rules": [
    "会话能力必须是任务需求的最小覆盖集合",
    "授权版本变化后未开始的调用不得继续",
    "写操作幂等键在租户与连接器范围内唯一",
    "单项能力撤销不得影响无关合法范围"
  ]
}
